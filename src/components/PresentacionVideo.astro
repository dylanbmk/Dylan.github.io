---
import { Icon } from 'astro-icon/components';

const videoId = 'MOnU2MRJGv0';
const videoUrl = `https://youtube.com/shorts/${videoId}`;
---

<section
  id="presentacion"
  class="mb-24 scroll-mt-24 lg:mb-32 lg:scroll-mt-8"
  aria-labelledby="presentacion-heading"
>
  <h2 id="presentacion-heading" class="section-heading">Presentación</h2>

  <div class="scroll-stat panel-card grid items-center gap-8 md:grid-cols-[1fr_14rem]">
    <div class="space-y-4">
      <p class="font-mono text-xs uppercase tracking-widest text-accent">Video de presentación</p>
      <h3 class="font-heading text-2xl font-semibold text-slate">Conoce un poco sobre mí</h3>
      <p class="body-copy">
        En este video te cuento un poco sobre mí, mis intereses y lo que espero aprender durante
        este semestre en Bases de Datos 2.
      </p>
      <a href={videoUrl} target="_blank" rel="noopener noreferrer" class="btn-accent">
        <Icon name="ph:youtube-logo" class="h-5 w-5" aria-hidden="true" />
        Ver en YouTube
      </a>
    </div>

    <div class="mx-auto w-full max-w-[16rem] overflow-hidden rounded-xl border border-accent/40 shadow-lg">
      <div class="relative aspect-[9/16]">
        <iframe
          class="absolute inset-0 h-full w-full"
          src={`https://www.youtube-nocookie.com/embed/${videoId}`}
          title="Video de presentación de Dylan"
          loading="lazy"
          allow="accelerometer; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </div>
</section>
